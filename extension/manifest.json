{
  "manifest_version": 3,
  "name": "OVD Downloader - Video & Audio Saver",
  "version": "1.3.0",
  "description": "Fast 1-click media saver to download public videos, reels, photos, and audio tracks directly from your active browser tab.",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://anydownloader-backend-vvbj.onrender.com/*",
    "https://ovd.winplaybox.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OVD Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}