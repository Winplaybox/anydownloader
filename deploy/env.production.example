# Copy to /opt/ovd/.env on the VPS (chmod 600). Never commit the real file.
# Generate each secret separately:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Domains / TLS -----------------------------------------------------------
API_DOMAIN=api.winplaybox.in
PUBLIC_BASE_URL=https://api.winplaybox.in
ACME_EMAIL=sagarsuthar530@gmail.com
ALLOWED_ORIGINS=https://ovd.winplaybox.in,https://winplaybox.in,https://www.winplaybox.in

# --- Secrets (all distinct, 32+ chars) ---------------------------------------
WPB_JWT_SECRET=
ADMIN_API_KEY=
TOKEN_HMAC_SECRET=
EXTENSION_SECRET_KEY=
WPB_VAULT_SECRET=
JOB_OWNER_SECRET=
SERVICE_TOKEN_PEPPER=
REDIS_PASSWORD=

# Admin console: these Google-verified emails are admins when signed in on OVD.
WPB_ADMIN_EMAILS=sagarsuthar530@gmail.com

# --- Google Sign-In (Google Cloud Console > Credentials > OAuth client "Web") -
# Authorized JavaScript origins: https://ovd.winplaybox.in
GOOGLE_CLIENT_ID=259545227984-tq7m462dc4vkqfv1g1ch66mou7uhigki.apps.googleusercontent.com

# --- Dodo Payments LIVE -------------------------------------------------------
# Dashboard (Live mode) > Developer > API keys / Webhooks.
# Webhook URL: https://api.winplaybox.in/api/payments/dodo/webhook
# Events: payment.succeeded, payment.failed, refund.succeeded, dispute.opened,
#         subscription.active, subscription.renewed, subscription.plan_changed,
#         subscription.on_hold, subscription.cancelled, subscription.expired, subscription.failed
DODO_PAYMENTS_ENV=live
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_RETURN_URL=https://ovd.winplaybox.in/payment/success

# LIVE product IDs (Live-mode products are different from Test-mode ones).
# A plan without an ID here simply cannot be bought (checkout returns a clear error).
DODO_PRODUCT_PLAN1=
DODO_PRODUCT_PLAN2=
DODO_PRODUCT_PLAN3=
DODO_PRODUCT_PLAN4=
DODO_PRODUCT_PLAN5=
DODO_PRODUCT_PLAN6=
DODO_PRODUCT_PLAN1_YEARLY=
DODO_PRODUCT_PLAN2_YEARLY=
DODO_PRODUCT_PLAN3_YEARLY=
DODO_PRODUCT_PLAN4_YEARLY=
DODO_PRODUCT_PLAN5_YEARLY=
DODO_PRODUCT_PLAN6_YEARLY=
DODO_PRODUCT_DAY_PASS=
DODO_PRODUCT_PACK_100=
DODO_PRODUCT_PACK_300=
DODO_PRODUCT_PACK_500=
DODO_PRODUCT_PACK_1500=

# --- AI providers used by the editor's script/metadata planner (optional) ----
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Capacity (KVM 2 = 2 vCPU / 8 GB) ----------------------------------------
API_WORKERS=2
API_CPUS=1.0
API_MEMORY_LIMIT=2g
WORKER_CPUS=1.5
WORKER_MEMORY_LIMIT=4g
EDITOR_CONCURRENCY=1
EDITOR_MAX_PENDING=25
EDITOR_MAX_UPLOAD_MB=100
EDITOR_MAX_SECONDS=300
EDITOR_WHISPER_MODEL=base

# Legacy shared automation key: leave empty and use scoped service tokens instead.
AUTOMATION_API_KEY=
