# Copy to worker.env (start_worker.bat does it on first run)
WORKER_KEY=change-me
NGROK_DOMAIN=your-name.ngrok-free.app
# Defaults to the ngrok domain when set, otherwise https://worker.winplaybox.in.
# For a same-host client, use http://127.0.0.1:8787.
WORKER_PUBLIC_BASE_URL=
# Optional private directory outside any web server's document root.
WORKER_MEDIA_DIR=
PORT=8787
MAX_HEIGHT=1080
DOWNLOAD_TIMEOUT_S=240
# Optional: server-side Netscape cookies.txt path for YouTube or Instagram.
COOKIES_FILE=
